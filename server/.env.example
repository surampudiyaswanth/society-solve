PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String:
# For local MongoDB: mongodb://127.0.0.1:27017/societysolve
# For MongoDB Atlas (Free Cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/societysolve?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/societysolve

# JWT Secret Key for Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d
